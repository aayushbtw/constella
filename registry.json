{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "aayush",
  "homepage": "https://ui.aayush.cv",
  "items": [
    {
      "name": "base",
      "type": "registry:lib",
      "title": "Base",
      "description": "Tokens, gray scale, theme and focus ring every component builds on.",
      "dependencies": ["@stylexjs/stylex", "@radix-ui/colors"],
      "files": [
        {
          "path": "src/lib/tokens.stylex.ts",
          "type": "registry:lib"
        },
        {
          "path": "src/lib/base.css",
          "type": "registry:lib"
        }
      ],
      "docs": "Needs the StyleX compiler with an `@/*` alias. Toggle dark mode with a `.dark` class on <html>. Setup: https://ui.aayush.cv"
    },
    {
      "name": "danger",
      "type": "registry:lib",
